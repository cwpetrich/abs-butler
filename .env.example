# Copy to .env and fill in. .env is gitignored.
#
# Since 0.2 the database is the source of truth for servers and settings — add
# servers from the web UI or `abs-butler server add`, not from here. What
# remains below is everything that must be known before the database opens.

# ---------------------------------------------------------------------------
# Web UI
# ---------------------------------------------------------------------------

# Required to log in. Without it the UI is UNAUTHENTICATED and anyone who can
# reach the port can read and manage your AudiobookShelf servers.
BUTLER_PASSWORD=

# Encrypts stored AudiobookShelf API keys at rest (AES-256-GCM). Without it,
# keys are stored in plaintext and the UI says so. Use a long random string:
#   openssl rand -base64 32
# Changing it makes existing keys unreadable — you must re-enter them.
BUTLER_SECRET=

BUTLER_HOST=0.0.0.0
BUTLER_PORT=8478

# Where the SQLite database lives. Defaults to ./data, and /data in Docker.
BUTLER_DATA_DIR=

# ---------------------------------------------------------------------------
# Docker only. See docs/docker.md.
# ---------------------------------------------------------------------------

# Host path to your audiobooks. Mounted at /library inside the container.
# Only needed for `organize`; every other command works purely over the API.
HOST_LIBRARY_PATH=

# The library is mounted read-only by default. Set to rw only when you intend
# to run `organize --apply`, which moves files.
LIBRARY_MOUNT_MODE=ro

# User that owns those files, so `organize` writes as you. Find yours with `id -u; id -g`.
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Optional: import a pre-0.2 single-server configuration
# ---------------------------------------------------------------------------
# If ABS_URL and ABS_TOKEN are set and no servers exist yet, they are imported
# into the database once on first run. After that, manage servers in the UI.
#
# ABS_URL=http://localhost:13378
# ABS_TOKEN=
# ABS_SERVER_NAME=default
# LIBRARY_ROOT=
# ABS_PATH_PREFIX=
# GOOGLE_BOOKS_API_KEY=
# PROVIDER_CONCURRENCY=4
