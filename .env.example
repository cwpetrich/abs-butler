# Copy to .env and fill in. .env is gitignored.

# Base URL of your AudiobookShelf server (no trailing slash).
ABS_URL=http://localhost:13378

# Preferred: an API token. In AudiobookShelf, get it from
# Settings -> Users -> (your user) -> API Token, or from the response of /login.
ABS_TOKEN=

# Alternative to ABS_TOKEN: username/password. abs-butler will call /login
# to exchange these for a token at startup. Token is never written to disk.
ABS_USERNAME=
ABS_PASSWORD=

# Optional. Google Books works without a key but is rate limited harder.
# https://developers.google.com/books/docs/v1/using#APIKey
GOOGLE_BOOKS_API_KEY=

# Optional. Filesystem root of the library AS SEEN BY THIS MACHINE.
# Only needed for `abs-butler organize`, which moves files directly.
# If AudiobookShelf runs in Docker, this is the HOST path, and ABS_PATH_PREFIX
# is the matching in-container path so paths can be translated.
#
# Running abs-butler itself in Docker? Leave this alone: docker-compose.yml
# forces it to /library and mounts HOST_LIBRARY_PATH there. See docs/docker.md.
LIBRARY_ROOT=
ABS_PATH_PREFIX=

# Requests in flight against external metadata providers.
PROVIDER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Docker only. Ignored when running the CLI directly. See docs/docker.md.
# ---------------------------------------------------------------------------

# Host path to your audiobooks. Mounted at /library inside the container.
HOST_LIBRARY_PATH=

# User that owns those files, so `organize` writes as you. Find yours with `id -u; id -g`.
PUID=1000
PGID=1000

# The library is mounted read-only by default. Set to rw only when you intend
# to run `organize --apply`, which moves files.
LIBRARY_MOUNT_MODE=ro

# Interval for the scheduled services: a number with s/m/h/d (e.g. 30m, 12h, 1d).
BUTLER_SCHEDULE=12h

# If AudiobookShelf runs on this same host (not in the compose network), the
# container cannot reach it at localhost. Use one of:
#   ABS_URL=http://host.docker.internal:13378   (with the extra_hosts entry in compose)
#   ABS_URL=http://<your-lan-ip>:13378
# If it runs in Docker too, put both on one network and use its service name:
#   ABS_URL=http://audiobookshelf:80
