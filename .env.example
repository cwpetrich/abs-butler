# Copy to .env. Everything in here is optional.
#
# Since 0.3 abs-butler configures itself: the AudiobookShelf connection, your
# password, provider keys and every other setting are edited in the web UI and
# stored in the database. The encryption key generates itself on first use.
#
# What remains below is the handful of deployment facts that must be known
# before the database can be opened or reached at all.

# ---------------------------------------------------------------------------
# Where things live
# ---------------------------------------------------------------------------

# Where the database and encryption key live. Defaults to ~/.local/share/abs-butler
# when run directly, and /data in Docker. Back this up — it holds your
# connection, credentials, history, and settings.
BUTLER_DATA_DIR=

# Listen address. These stay environment variables on purpose: a wrong value
# set from the UI would lock you out of the only thing that could fix it.
BUTLER_HOST=0.0.0.0
BUTLER_PORT=13380

# Docker only: which host address the UI is published on. Loopback by default,
# because the setup page has to be anonymous until a password exists. Set it to
# 0.0.0.0 to reach abs-butler from another machine.
BUTLER_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Docker only. See docs/docker.md.
# ---------------------------------------------------------------------------

# Host path to your audiobooks — the same directory AudiobookShelf uses.
# Mounted at /audiobooks inside the container. Only needed for `organize`;
# every other command works purely over the API.
HOST_LIBRARY_PATH=

# Whether abs-butler may move files is set in the UI, under Settings → File
# changes, and is off until you turn it on. It used to be a mount flag here,
# which meant recreating the container to change it.

# User that owns those files, so `organize` writes as you. Find yours with `id -u; id -g`.
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Optional hardening
# ---------------------------------------------------------------------------

# First-run setup is normally guarded by a 15-minute window plus a browser
# claim, which is the right trade on a home network. Set this and a code is
# required as well — worth doing if this port is reachable from outside.
# BUTLER_SETUP_CODE=

# Manage the encryption key yourself instead of letting abs-butler generate
# one (Docker secrets, Kubernetes, a password manager). If set, it takes
# precedence over the key file and cannot be rotated from the UI.
# BUTLER_SECRET=
