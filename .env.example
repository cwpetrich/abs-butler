# Copy to .env and fill in. .env is gitignored.

# Base URL of your AudiobookShelf server (no trailing slash).
ABS_URL=http://localhost:13378

# Preferred: an API token. In AudiobookShelf, get it from
# Settings -> Users -> (your user) -> API Token, or from the response of /login.
ABS_TOKEN=

# Alternative to ABS_TOKEN: username/password. abs-butler will call /login
# to exchange these for a token at startup. Token is never written to disk.
ABS_USERNAME=
ABS_PASSWORD=

# Optional. Google Books works without a key but is rate limited harder.
# https://developers.google.com/books/docs/v1/using#APIKey
GOOGLE_BOOKS_API_KEY=

# Optional. Filesystem root of the library AS SEEN BY THIS MACHINE.
# Only needed for `abs-butler organize`, which moves files directly.
# If AudiobookShelf runs in Docker, this is the HOST path, and ABS_PATH_PREFIX
# is the matching in-container path so paths can be translated.
LIBRARY_ROOT=
ABS_PATH_PREFIX=

# Requests in flight against external metadata providers.
PROVIDER_CONCURRENCY=4
